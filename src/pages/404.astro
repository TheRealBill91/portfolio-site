---
import "../styles/global.css";
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="robots" content="noindex" />
    <script is:inline>
      document.documentElement.dataset.theme =
        localStorage.getItem("theme") ??
        (matchMedia("(prefers-color-scheme: dark)").matches ? "dark" : "light");
    </script>
    <title>Page not found</title>
    <link rel="icon" href="/favicon.svg" type="image/svg+xml" />
  </head>
  <body class="font-sans">
    <main class="mx-auto flex min-h-dvh max-w-2xl flex-col justify-center px-6">
      <p class="text-sm text-[var(--muted)]">404</p>
      <h1 class="mt-2 text-2xl font-semibold tracking-tight">This page doesn't exist.</h1>
      <a href="/" class="mt-6 text-[var(--accent)] underline-offset-4 hover:underline">← Back home</a>
    </main>
  </body>
</html>
