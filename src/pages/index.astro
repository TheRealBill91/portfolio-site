---
import "../styles/global.css";
import { profile } from "../data/profile";
import ThemeToggle from "../components/ThemeToggle.astro";

const title = `${profile.name} · ${profile.headline}`;
const description = profile.intro;
const shareTitle = `${profile.name} — ${profile.headline.split(" — ")[0]}`;
// Preview images must be absolute URLs; Astro.site comes from astro.config.mjs.
const siteUrl = new URL("/", Astro.site).href;
const ogImage = new URL("/og.png", Astro.site).href;
const year = new Date().getFullYear();
const current = profile.experience.find((role) => role.current);
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{title}</title>
    <meta name="description" content={description} />

    <!-- Link previews (iMessage, Slack, LinkedIn, Facebook, Discord, etc.) -->
    <meta property="og:type" content="website" />
    <meta property="og:site_name" content={profile.name} />
    <meta property="og:title" content={shareTitle} />
    <meta property="og:description" content={description} />
    <meta property="og:url" content={siteUrl} />
    <meta property="og:image" content={ogImage} />
    <meta property="og:image:width" content="1200" />
    <meta property="og:image:height" content="630" />
    <meta property="og:image:alt" content={`${profile.name}, ${profile.headline}`} />
    <!-- X / Twitter uses its own tags for the large-image card. -->
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:title" content={shareTitle} />
    <meta name="twitter:description" content={description} />
    <meta name="twitter:image" content={ogImage} />

    <link rel="canonical" href={siteUrl} />
    <link rel="icon" href="/favicon.svg" type="image/svg+xml" />
    <link rel="apple-touch-icon" href="/apple-touch-icon.png" />
    <meta name="theme-color" content="#fbfbfa" media="(prefers-color-scheme: light)" />
    <meta name="theme-color" content="#0c0c0e" media="(prefers-color-scheme: dark)" />
    <script is:inline>
      // Runs before first paint: apply a saved theme choice, else the system preference.
      document.documentElement.dataset.theme =
        localStorage.getItem("theme") ??
        (matchMedia("(prefers-color-scheme: dark)").matches ? "dark" : "light");
    </script>
  </head>

  <body class="font-sans">
    <main class="mx-auto max-w-2xl px-6 pt-20 pb-16 sm:pt-28">
      <!-- Intro -->
      <header class="reveal" style="--i: 0">
        <div class="flex items-start justify-between gap-4">
          <div>
            <h1 class="text-[1.65rem] font-semibold tracking-tight sm:text-3xl">
              {profile.name}
            </h1>
            <p class="mt-1.5 text-[var(--muted)]">{profile.headline}</p>
          </div>
          <ThemeToggle />
        </div>

        <p class="mt-8 max-w-xl text-lg leading-relaxed text-pretty sm:text-xl sm:leading-relaxed">
          {profile.intro}
        </p>

        <div class="mt-8 flex flex-wrap items-center gap-x-6 gap-y-3 text-sm">
          <a
            href={profile.linkedin}
            target="_blank"
            rel="noopener noreferrer"
            class="group inline-flex items-center gap-2 rounded-full bg-[var(--fg)] px-4 py-2 font-medium text-[var(--bg)] transition hover:opacity-85 focus-visible:outline-2 focus-visible:outline-offset-2 focus-visible:outline-[var(--accent)]"
          >
            <svg viewBox="0 0 24 24" class="size-4" fill="currentColor" aria-hidden="true">
              <path d="M20.45 20.45h-3.56v-5.57c0-1.33-.02-3.04-1.85-3.04-1.85 0-2.14 1.45-2.14 2.94v5.67H9.35V9h3.41v1.56h.05c.48-.9 1.64-1.85 3.37-1.85 3.6 0 4.27 2.37 4.27 5.46v6.28ZM5.34 7.43a2.06 2.06 0 1 1 0-4.13 2.06 2.06 0 0 1 0 4.13ZM7.12 20.45H3.56V9h3.56v11.45ZM22.22 0H1.77C.79 0 0 .77 0 1.73v20.54C0 23.23.79 24 1.77 24h20.45c.98 0 1.78-.77 1.78-1.73V1.73C24 .77 23.2 0 22.22 0Z" />
            </svg>
            Connect on LinkedIn
            <span aria-hidden="true" class="transition group-hover:translate-x-0.5">→</span>
          </a>

          {
            current && (
              <span class="inline-flex items-center gap-2 text-[var(--muted)]">
                <span class="relative flex size-2">
                  <span class="absolute inline-flex size-full animate-ping rounded-full bg-emerald-500 opacity-40 motion-reduce:hidden" />
                  <span class="relative inline-flex size-2 rounded-full bg-emerald-500" />
                </span>
                Currently at {current.company}
              </span>
            )
          }
        </div>
      </header>

      <!-- About -->
      <section class="reveal mt-20 grid gap-4 border-t border-[var(--faint)] pt-10 sm:grid-cols-[9rem_1fr] sm:gap-8" style="--i: 1" aria-labelledby="about">
        <h2 id="about" class="text-sm font-medium text-[var(--muted)]">About</h2>
        <div class="space-y-4 leading-relaxed text-pretty">
          {profile.about.map((paragraph) => <p>{paragraph}</p>)}
        </div>
      </section>

      <!-- Experience -->
      <section class="reveal mt-14 grid gap-4 border-t border-[var(--faint)] pt-10 sm:grid-cols-[9rem_1fr] sm:gap-8" style="--i: 2" aria-labelledby="experience">
        <h2 id="experience" class="text-sm font-medium text-[var(--muted)]">Experience</h2>
        <ol class="space-y-10">
          {
            profile.experience.map((role) => (
              <li>
                <div class="flex flex-col gap-0.5 sm:flex-row sm:items-baseline sm:justify-between sm:gap-4">
                  <h3 class="font-medium">
                    {role.title}
                    <span class="text-[var(--muted)]"> · {role.company}</span>
                  </h3>
                  <p class="shrink-0 text-sm text-[var(--muted)] tabular-nums">
                    {role.start === role.end ? role.start : `${role.start} — ${role.end}`}
                  </p>
                </div>
                {role.highlights.length > 0 && (
                <ul class="mt-3 space-y-1.5 text-[0.95rem] leading-relaxed text-[var(--muted)]">
                  {role.highlights.map((item) => (
                    <li class="relative pl-4 before:absolute before:top-[0.7em] before:left-0 before:size-1 before:rounded-full before:bg-[var(--muted)] before:opacity-50 before:content-['']">
                      {item}
                    </li>
                  ))}
                </ul>
                )}
              </li>
            ))
          }
        </ol>
      </section>

      <!-- Education -->
      <section class="reveal mt-14 grid gap-4 border-t border-[var(--faint)] pt-10 sm:grid-cols-[9rem_1fr] sm:gap-8" style="--i: 3" aria-labelledby="education">
        <h2 id="education" class="text-sm font-medium text-[var(--muted)]">Education</h2>
        <ul class="space-y-4">
          {
            profile.education.map((item) => (
              <li class="flex flex-col gap-0.5 sm:flex-row sm:items-baseline sm:justify-between sm:gap-4">
                <div>
                  <h3 class="font-medium">{item.degree}</h3>
                  <p class="text-[0.95rem] text-[var(--muted)]">
                    {item.school}
                    {item.note && <span> · {item.note}</span>}
                  </p>
                </div>
                <p class="shrink-0 text-sm text-[var(--muted)] tabular-nums">{item.year}</p>
              </li>
            ))
          }
        </ul>
      </section>

      <!-- Skills -->
      <section class="reveal mt-14 grid gap-4 border-t border-[var(--faint)] pt-10 sm:grid-cols-[9rem_1fr] sm:gap-8" style="--i: 4" aria-labelledby="skills">
        <h2 id="skills" class="text-sm font-medium text-[var(--muted)]">Skills</h2>
        <ul class="flex flex-wrap gap-2">
          {
            profile.skills.map((skill) => (
              <li class="rounded-full border border-[var(--faint)] px-3 py-1 text-sm">{skill}</li>
            ))
          }
        </ul>
      </section>

      <footer class="reveal mt-20 border-t border-[var(--faint)] pt-8 text-sm text-[var(--muted)]" style="--i: 5">
        <p>© {year} {profile.name}</p>
      </footer>
    </main>
  </body>
</html>
