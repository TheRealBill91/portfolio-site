---
import "../styles/global.css";
import { profile } from "../data/profile";
import ThemeToggle from "../components/ThemeToggle.astro";

const title = `${profile.name} · ${profile.headline}`;
const description = profile.intro;
const shareTitle = `${profile.name} — ${profile.headline.split(" — ")[0]}`;
// Preview images must be absolute URLs; Astro.site comes from astro.config.mjs.
const siteUrl = new URL("/", Astro.site).href;
// Bump ?v= whenever og.png changes so apps that cached the old preview fetch the new one.
const ogImage = new URL("/og.png?v=3", Astro.site).href;
const year = new Date().getFullYear();
const current = profile.experience.find((role) => role.current);
const [firstName, ...rest] = profile.name.split(" ");
const lastName = rest.join(" ");
const [role, focus] = profile.headline.split(" — ");

// Decorative status strip: a wink at network monitoring. Fixed positions for
// the two amber bars so the build is deterministic.
const bars = Array.from({ length: 72 }, (_, i) => ({ warn: i === 23 || i === 51 }));
const pad = (n: number) => String(n).padStart(2, "0");
---

<!doctype html>
<html lang="en" id="top">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{title}</title>
    <meta name="description" content={description} />

    <!-- Link previews (iMessage, Slack, LinkedIn, Facebook, Discord, etc.) -->
    <meta property="og:type" content="website" />
    <meta property="og:site_name" content={profile.name} />
    <meta property="og:title" content={shareTitle} />
    <meta property="og:description" content={description} />
    <meta property="og:url" content={siteUrl} />
    <meta property="og:image" content={ogImage} />
    <meta property="og:image:width" content="1200" />
    <meta property="og:image:height" content="630" />
    <meta property="og:image:alt" content={`${profile.name}, ${profile.headline}`} />
    <!-- X / Twitter uses its own tags for the large-image card. -->
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:title" content={shareTitle} />
    <meta name="twitter:description" content={description} />
    <meta name="twitter:image" content={ogImage} />

    <link rel="canonical" href={siteUrl} />
    <link rel="icon" href="/favicon.svg" type="image/svg+xml" />
    <link rel="apple-touch-icon" href="/apple-touch-icon.png" />
    <meta name="theme-color" content="#f3f0e8" media="(prefers-color-scheme: light)" />
    <meta name="theme-color" content="#0e0f0d" media="(prefers-color-scheme: dark)" />
    <script is:inline>
      // Runs before first paint: apply a saved theme choice, else the system preference.
      document.documentElement.dataset.theme =
        localStorage.getItem("theme") ??
        (matchMedia("(prefers-color-scheme: dark)").matches ? "dark" : "light");
    </script>
  </head>

  <body class="font-sans">
    <div class="mx-auto max-w-6xl px-6 sm:px-10">
      <!-- Top bar -->
      <div class="reveal flex items-center justify-between border-b border-[var(--faint)] py-5 font-mono text-label tracking-[0.14em] text-[var(--muted)] uppercase" style="--i: 0">
        <span>billycummings.com</span>
        <div class="flex items-center gap-5">
          <span class="hidden items-center gap-2 sm:inline-flex">
            <span class="size-1.5 rounded-full bg-[var(--accent)]"></span>
            Status: operational
          </span>
          <ThemeToggle />
        </div>
      </div>

      <main>
        <!-- Hero -->
        <header class="grid gap-10 pt-16 pb-14 sm:pt-24 lg:grid-cols-12 lg:gap-8 lg:pb-20">
          <div class="lg:col-span-7">
            <p class="reveal font-mono text-meta tracking-[0.14em] text-[var(--muted)] uppercase" style="--i: 1">
              {role}<span class="text-[var(--accent)]"> / </span>{focus}
            </p>
            <h1 class="reveal mt-6 font-serif text-[clamp(4.25rem,14vw,9.5rem)] leading-[0.86] tracking-[-0.02em]" style="--i: 2">
              {firstName}<br /><em class="text-[var(--muted)]">{lastName}</em>
            </h1>
          </div>

          <div class="reveal flex flex-col justify-end lg:col-span-5 lg:pb-3" style="--i: 3">
            <p class="text-xl leading-[1.45] text-pretty sm:text-[1.4rem]">{profile.intro}</p>
            <div class="mt-8 flex flex-wrap items-center gap-x-6 gap-y-4">
              <a
                href={profile.linkedin}
                target="_blank"
                rel="noopener noreferrer"
                class="group inline-flex items-center gap-2.5 bg-[var(--fg)] px-5 py-3 text-sm font-medium text-[var(--bg)] transition hover:bg-[var(--accent)] focus-visible:outline-2 focus-visible:outline-offset-2 focus-visible:outline-[var(--accent)]"
              >
                <svg viewBox="0 0 24 24" class="size-4" fill="currentColor" aria-hidden="true">
                  <path d="M20.45 20.45h-3.56v-5.57c0-1.33-.02-3.04-1.85-3.04-1.85 0-2.14 1.45-2.14 2.94v5.67H9.35V9h3.41v1.56h.05c.48-.9 1.64-1.85 3.37-1.85 3.6 0 4.27 2.37 4.27 5.46v6.28ZM5.34 7.43a2.06 2.06 0 1 1 0-4.13 2.06 2.06 0 0 1 0 4.13ZM7.12 20.45H3.56V9h3.56v11.45ZM22.22 0H1.77C.79 0 0 .77 0 1.73v20.54C0 23.23.79 24 1.77 24h20.45c.98 0 1.78-.77 1.78-1.73V1.73C24 .77 23.2 0 22.22 0Z" />
                </svg>
                Connect on LinkedIn
                <span aria-hidden="true" class="transition group-hover:translate-x-1">→</span>
              </a>
              {
                current && (
                  <span class="inline-flex items-center gap-2 font-mono text-meta tracking-wide text-[var(--muted)]">
                    <span class="relative flex size-2">
                      <span class="absolute inline-flex size-full animate-ping rounded-full bg-[var(--accent)] opacity-50 motion-reduce:hidden" />
                      <span class="relative inline-flex size-2 rounded-full bg-[var(--accent)]" />
                    </span>
                    Currently at {current.company}
                  </span>
                )
              }
            </div>
          </div>
        </header>

        <!-- Status strip (decorative) -->
        <div class="reveal pb-20 sm:pb-28" style="--i: 4" aria-hidden="true">
          <div class="flex h-9 items-end gap-[3px]">
            {
              bars.map((bar, i) => (
                <span
                  class:list={[
                    "status-bar h-full flex-1 rounded-[1px] opacity-80",
                    bar.warn ? "bg-[var(--warn)]" : "bg-[var(--accent)]",
                    i >= 40 && "hidden sm:block",
                  ]}
                  style={`--b: ${i}`}
                />
              ))
            }
          </div>
          <div class="mt-3 flex justify-between font-mono text-label tracking-[0.14em] text-[var(--muted)] uppercase">
            <span>Signal</span>
            <span>All systems operational</span>
          </div>
        </div>

        <!-- About -->
        <section class="grid gap-6 border-t border-[var(--fg)] pt-6 pb-20 lg:grid-cols-12 lg:gap-8 lg:pb-28" aria-labelledby="about">
          <h2 id="about" class="font-mono text-label tracking-[0.14em] text-[var(--muted)] uppercase lg:col-span-4">
            <span class="text-[var(--fg)]">01</span> — About
          </h2>
          <div class="space-y-6 lg:col-span-8">
            <p class="font-serif text-[clamp(1.75rem,3.6vw,2.6rem)] leading-[1.15] text-pretty">
              {profile.about[0]}
            </p>
            {profile.about.slice(1).map((paragraph) => (
              <p class="max-w-2xl text-lg leading-relaxed text-pretty text-[var(--muted)]">{paragraph}</p>
            ))}
          </div>
        </section>

        <!-- Experience -->
        <section class="grid gap-6 border-t border-[var(--fg)] pt-6 pb-20 lg:grid-cols-12 lg:gap-8 lg:pb-28" aria-labelledby="experience">
          <h2 id="experience" class="font-mono text-label tracking-[0.14em] text-[var(--muted)] uppercase lg:col-span-4">
            <span class="text-[var(--fg)]">02</span> — Experience
          </h2>
          <ol class="lg:col-span-8">
            {
              profile.experience.map((item) => (
                <li class="grid gap-3 border-b border-[var(--faint)] py-8 first:pt-0 last:border-b-0 sm:grid-cols-[8rem_1fr] sm:gap-6">
                  <p class="font-mono text-meta tracking-wide text-[var(--muted)] tabular-nums sm:pt-2.5">
                    {item.start === item.end ? item.start : `${item.start} – ${item.end}`}
                  </p>
                  <div>
                    <h3 class="font-serif text-[1.85rem] leading-tight">{item.title}</h3>
                    <p class="mt-1.5 flex items-center gap-2 font-mono text-meta tracking-[0.12em] text-[var(--muted)] uppercase">
                      {item.company}
                      {item.current && (
                        <span class="inline-flex items-center gap-1.5 text-[var(--accent)]">
                          <span class="size-1.5 rounded-full bg-[var(--accent)]" />
                          Now
                        </span>
                      )}
                    </p>
                    {item.highlights.length > 0 && (
                      <ul class="mt-5 space-y-2.5 leading-relaxed text-pretty text-[var(--muted)]">
                        {item.highlights.map((highlight) => (
                          <li class="grid grid-cols-[1.25rem_1fr]">
                            <span aria-hidden="true" class="text-[var(--accent)]">–</span>
                            {highlight}
                          </li>
                        ))}
                      </ul>
                    )}
                  </div>
                </li>
              ))
            }
          </ol>
        </section>

        <!-- Education -->
        <section class="grid gap-6 border-t border-[var(--fg)] pt-6 pb-20 lg:grid-cols-12 lg:gap-8 lg:pb-28" aria-labelledby="education">
          <h2 id="education" class="font-mono text-label tracking-[0.14em] text-[var(--muted)] uppercase lg:col-span-4">
            <span class="text-[var(--fg)]">03</span> — Education
          </h2>
          <ul class="lg:col-span-8">
            {
              profile.education.map((item) => (
                <li class="grid gap-3 sm:grid-cols-[8rem_1fr] sm:gap-6">
                  <p class="font-mono text-meta tracking-wide text-[var(--muted)] tabular-nums sm:pt-2.5">{item.year}</p>
                  <div>
                    <h3 class="font-serif text-[1.85rem] leading-tight">{item.degree}</h3>
                    <p class="mt-1.5 font-mono text-meta tracking-[0.12em] text-[var(--muted)] uppercase">
                      {item.school}
                      {item.note && <span class="text-[var(--accent)]"> · {item.note}</span>}
                    </p>
                  </div>
                </li>
              ))
            }
          </ul>
        </section>

        <!-- Skills -->
        <section class="grid gap-6 border-t border-[var(--fg)] pt-6 pb-20 lg:grid-cols-12 lg:gap-8 lg:pb-28" aria-labelledby="skills">
          <h2 id="skills" class="font-mono text-label tracking-[0.14em] text-[var(--muted)] uppercase lg:col-span-4">
            <span class="text-[var(--fg)]">04</span> — Skills
          </h2>
          <ol class="grid sm:grid-cols-2 sm:gap-x-10 lg:col-span-8">
            {
              profile.skills.map((skill, i) => (
                <li class="flex items-baseline gap-4 border-b border-[var(--faint)] py-3.5">
                  <span class="font-mono text-label text-[var(--muted)] tabular-nums">{pad(i + 1)}</span>
                  <span class="text-[1.05rem]">{skill}</span>
                </li>
              ))
            }
          </ol>
        </section>
      </main>

      <!-- Footer -->
      <footer class="border-t border-[var(--fg)] pt-14 pb-10">
        <a
          href={profile.linkedin}
          target="_blank"
          rel="noopener noreferrer"
          class="group inline-flex items-baseline gap-4 font-serif text-[clamp(2.5rem,7vw,5rem)] leading-none"
        >
          <span class="link pb-1">Let's <em>connect</em></span>
          <span aria-hidden="true" class="text-[0.6em] text-[var(--accent)] transition group-hover:translate-x-2">→</span>
        </a>
        <div class="mt-16 flex flex-wrap justify-between gap-4 font-mono text-label tracking-[0.14em] text-[var(--muted)] uppercase">
          <span>© {year} {profile.name}</span>
          <a href="#top" class="link">Back to top ↑</a>
        </div>
      </footer>
    </div>
  </body>
</html>
